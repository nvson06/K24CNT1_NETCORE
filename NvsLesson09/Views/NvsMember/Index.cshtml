@model IEnumerable<NvsLesson09.Models.DataModels.NvsMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Danh sách thành viên</h1>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm thành viên
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.NvsMemberId)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NvsUserName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NvsEmail)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NvsPhoneNumber)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NvsFullname)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NvsBirthday)
                            </th>

                            <th style="width: 220px;">
                                Chức năng
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.NvsMemberId)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.NvsUserName)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.NvsEmail)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.NvsPhoneNumber)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.NvsFullname)
                                    </td>

                                    <td>
                                        @item.NvsBirthday.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.NvsMemberId"
                                           class="btn btn-warning btn-sm">
                                            Sửa
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.NvsMemberId"
                                           class="btn btn-info btn-sm">
                                            Chi tiết
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.NvsMemberId"
                                           class="btn btn-danger btn-sm">
                                            Xóa
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">
                                    Chưa có thành viên nào.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>