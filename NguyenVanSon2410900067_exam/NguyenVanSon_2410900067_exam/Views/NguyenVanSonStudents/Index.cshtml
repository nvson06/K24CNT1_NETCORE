@model IEnumerable<NguyenVanSon_2410900067_exam.Models.NguyenVanSonStudent>

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Danh sách Sinh viên</h2>

    <p>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            + Create New
        </a>
    </p>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.NguyenVanSonName)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenVanSonGender)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenVanSonBirthday)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenVanSonEmail)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenVanSonPhone)</th>
                    <th>@Html.DisplayNameFor(model => model.NguyenVanSonActive)</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.NguyenVanSonName)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenVanSonGender)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenVanSonBirthday)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenVanSonEmail)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenVanSonPhone)</td>
                        <td>@Html.DisplayFor(modelItem => item.NguyenVanSonActive)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>