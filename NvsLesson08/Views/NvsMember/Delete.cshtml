@model NvsLesson08.Models.NvsMember

@{
    ViewData["Title"] = "Xóa thành viên";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-trash-fill"></i>
                @ViewData["Title"]
            </h3>
        </div>
        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Cảnh báo!</strong>
                Bạn có chắc chắn muốn xóa thành viên này không?
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small">
                            Tên tài khoản
                        </div>

                        <div class="fw-semibold fs-5">
                            @Html.DisplayFor(model => model.NvsUserName)
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small">
                            Mật khẩu
                        </div>

                        <div class="fw-semibold fs-5">
                            ********
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small">
                            Họ và tên
                        </div>

                        <div class="fw-semibold fs-5">
                            @Html.DisplayFor(model => model.NvsFullName)
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small">
                            Email
                        </div>

                        <div class="fw-semibold fs-5">
                            @Html.DisplayFor(model => model.NvsEmail)
                        </div>
                    </div>
                </div>

            </div>

        </div>
        <div class="card-footer">

            <form asp-action="NvsDeleted" method="post" class="d-inline">

                <input type="hidden"
                       asp-for="NvsMemberId" />

                <button type="submit"
                        class="btn btn-danger me-2">
                    <i class="bi bi-trash-fill"></i>
                    Xóa thành viên
                </button>

            </form>

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>

        </div>

    </div>
</div>
