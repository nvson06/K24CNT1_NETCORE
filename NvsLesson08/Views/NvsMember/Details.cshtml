@model NvsLesson08.Models.NvsMember

@{
    ViewData["Title"] = "Chi tiết thành viên";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-vcard"></i>
                @ViewData["Title"]
            </h3>
        </div>
        <div class="card-body">

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small">
                            Tên tài khoản
                        </div>

                        <div class="fw-semibold fs-5">
                            @Html.DisplayFor(model => model.NvsUserName)
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small">
                            Mật khẩu
                        </div>

                        <div class="fw-semibold fs-5">
                            ********
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small">
                            Họ và tên
                        </div>

                        <div class="fw-semibold fs-5">
                            @Html.DisplayFor(model => model.NvsFullName)
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small">
                            Email
                        </div>

                        <div class="fw-semibold fs-5">
                            @Html.DisplayFor(model => model.NvsEmail)
                        </div>
                    </div>
                </div>

            </div>

        </div>
        <div class="card-footer">

            <a asp-action="NvsEdit"
               asp-route-id="@Model?.NvsMemberId"
               class="btn btn-warning me-2">
                <i class="bi bi-pencil-square"></i>
                Sửa
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>

        </div>

    </div>
</div>
